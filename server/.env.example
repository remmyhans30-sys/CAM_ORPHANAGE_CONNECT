PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
CORS_ORIGIN=*

# --- MySQL (the same server MySQL Workbench connects to) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cam_orphanage_connect

# --- Live site only (set these in the hosting panel, not in a committed file) ---
# NODE_ENV=production
# ADMIN_EMAIL=you@example.org        # first admin account, created on first start
# ADMIN_PASSWORD=a-long-password     # at least 8 characters; change it later in the admin panel
# SEED_SAMPLE_DATA=false             # no made-up sample orphanages
# SUPPORT_EMAIL=help@example.org  # shown on the forgot-password page when email is not set up
# VIDEO_MAX_MB=15                          # biggest video an orphanage can upload (at most 20)
# ORPHANAGE_VIDEO_QUOTA_MB=60               # total video storage per orphanage
# SITE_URL=https://example.alwaysdata.net   # the site's real address; reset links in emails point here
# SMTP_HOST=smtp.example.com                # the mail server used for password reset emails
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=
# SMTP_FROM=CAM Orphanage Connect <noreply@example.com>

# --- Sign-in protection (optional; these are the defaults) ---
# LOGIN_MAX_ATTEMPTS=5                      # wrong passwords for one email from one computer before it waits
# LOGIN_MAX_PER_EMAIL=50                    # wrong passwords for one email from all computers together
# LOGIN_MAX_PER_ADDRESS=100                 # wrong passwords from one internet address, any emails
# LOGIN_LOCK_MINUTES=15                     # the time those counts cover, and how long the wait is
